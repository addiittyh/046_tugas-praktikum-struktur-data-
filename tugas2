# TUGAS 2 (SHIFT OPERATION)
# =========================

# SHIFT LEFT (<<) → tambah nol di belakang
def shift_left(num, n):
    for _ in range(n):
        num.insert(0)
    return num


# SHIFT RIGHT (>>) → hapus digit terakhir
def shift_right(num, n):
    for _ in range(n):
        if num.head is None:
            break

        # jika hanya 1 digit
        if num.head.next is None:
            num.head = None
        else:
            temp = num.head
            while temp.next.next:
                temp = temp.next
            temp.next = None

    return num

if __name__ == "__main__":
    a = BigInteger()
    a.create("12345")

    print("A =", end=" ")
    a.display()

    # SHIFT LEFT
    shift_left(a, 2)
    print("A << 2 =", end=" ")
    a.display()

    # SHIFT RIGHT
    shift_right(a, 3)
    print("A >> 3 =", end=" ")
    a.display()
